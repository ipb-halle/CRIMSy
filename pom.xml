<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
 http://maven.apache.org/xsd/maven-4.0.0.xsd">

<!--
        Get some help on transient dependencies:

        mvn help:effective-pom
        mvn dependency:tree

-->

    <modelVersion>4.0.0</modelVersion>

    <groupId>de.ipb-halle</groupId>
    <artifactId>crimsy</artifactId>
    <version>2.2</version>
    <packaging>pom</packaging>

    <properties>
        <commons-cli.version>1.5.0</commons-cli.version>
        <commons-csv.version>1.10.0</commons-csv.version>
        <crimsy-api.version>1.0.0</crimsy-api.version>
        <crimsy-job-api.version>1.0.0</crimsy-job-api.version>
        <crimsy-job-storage.version>1.0.1</crimsy-job-storage.version>
        <crimsy-kx-api.version>1.0.0</crimsy-kx-api.version>
        <crimsy-test.version>1.0.1</crimsy-test.version>
        <crimsy-tx.version>1.0.3</crimsy-tx.version>
        <google-gson.version>2.10.1</google-gson.version>
        <hibernate-validator.version>8.0.3.Final</hibernate-validator.version>
<!--    <hibernate.version>6.1.7.Final</hibernate.version> -->
        <hibernate.version>6.6.50.Final</hibernate.version>
        <jakarta.platform.version>10.0.0</jakarta.platform.version>
        <Xjakarta.persistence-api.version>3.0.0</Xjakarta.persistence-api.version>
        <jupiter.version>6.0.3</jupiter.version>
        <log4j2.version>2.25.4</log4j2.version>
        <maven.assembly-plugin.version>3.1.1</maven.assembly-plugin.version>
        <maven.compiler-plugin.version>3.1</maven.compiler-plugin.version>
        <maven.surefire-plugin.version>3.1.2</maven.surefire-plugin.version>
        <postgresql.version>42.7.11</postgresql.version>
        <slf4j-api.version>1.7.30</slf4j-api.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <tomee-jaxrs.version>10.0.0</tomee-jaxrs.version>
        <tomee.version>10.0.1</tomee.version>
    </properties>

    <modules>
        <module>crimsy-test</module>
        <module>crimsy-api</module>
        <module>crimsy-job-api</module>
        <module>crimsy-job-storage</module>
        <module>agency</module>
        <module>snowball</module>
        <module>tx</module>
        <module>kx-api</module>
        <module>kx-web</module>
        <module>reporting-api</module>
        <module>reporting</module>
        <module>ui</module>
    </modules>

    <build>
        <plugins>
            <!-- Copy the dependencies used by the server container into an extra folder -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>copy</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>${project.basedir}/target/extralib/</outputDirectory>
                    <artifactItems>
                        <artifactItem>
                            <groupId>org.antlr</groupId>
                            <artifactId>antlr4</artifactId>
                            <version>4.12.0</version>
                            <type>jar</type>
                        </artifactItem>
                        <artifactItem>
                            <groupId>org.antlr</groupId>
                            <artifactId>antlr4-runtime</artifactId>
                            <version>4.12.0</version>
                            <type>jar</type>
                        </artifactItem>
                        <artifactItem>
                            <groupId>com.fasterxml</groupId>
                            <artifactId>classmate</artifactId>
                            <version>1.5.1</version>
                        </artifactItem>
                        <artifactItem>
                            <groupId>org.dom4j</groupId>
                            <artifactId>dom4j</artifactId>
                            <version>2.1.4</version>
                        </artifactItem>
<!--
                        <artifactItem>
                            <groupId>org.apache.myfaces.core</groupId>
                            <artifactId>myfaces-bundle</artifactId>
                            <version>4.0.0</version>
                        </artifactItem>
-->
                        <artifactItem>
                            <groupId>org.hibernate.common</groupId>
                            <artifactId>hibernate-commons-annotations</artifactId>
                            <version>6.0.6.Final</version>
                        </artifactItem>
                        <artifactItem>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-core</artifactId>
                            <version>${hibernate.version}</version>
                        </artifactItem>

                        <!-- Integration for using Ehcache 2.x as a 
                        Hibernate second-level-cache provider  -->
<!--
                        <artifactItem>
                            <groupId>org.hibernate</groupId>
                            <artifactId>hibernate-ehcache</artifactId>
                            <version>6.0.0.Alpha7</version>
                        </artifactItem>
                        <dependency>
                            <groupId>jakarta.persistence</groupId>
                            <artifactId>jakarta.persistence-api</artifactId>
                            <version>${Xjakarta.persistence-api.version}</version>
                        </dependency>
-->
                        <artifactItem>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy</artifactId>
                            <version>1.14.0</version>
                        </artifactItem>
                        <artifactItem>
                            <groupId>org.hibernate.validator</groupId>
                            <artifactId>hibernate-validator</artifactId>
                            <version>${hibernate-validator.version}</version>
                        </artifactItem>   
                        <artifactItem>
                            <groupId>org.javassist</groupId>
                            <artifactId>javassist</artifactId>
                            <version>3.29.2-GA</version>
                        </artifactItem>     
                        <artifactItem>
                            <groupId>org.jboss.logging</groupId>
                            <artifactId>jboss-logging</artifactId>
                            <version>3.5.0.Final</version>
                        </artifactItem>    
                        <artifactItem>
                            <groupId>org.postgresql</groupId>
                            <artifactId>postgresql</artifactId>
                            <version>${postgresql.version}</version>
                        </artifactItem>
                    </artifactItems>
                </configuration>
            </plugin>

            <!-- create software BOM -->
            <!-- please check for updates on https://search.maven.org/search?q=a:spdx-maven-plugin -->  
<!--
            <plugin>
                <groupId>org.spdx</groupId>
                <artifactId>spdx-maven-plugin</artifactId>
                <version>0.6.4</version>
                <executions>
                    <execution>
                        <id>build-spdx</id>
                        <goals>
                            <goal>createSPDX</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                  <excludedFilePatterns>
                    <param>*.spdx</param>
                  </excludedFilePatterns>
                </configuration>
            </plugin>
-->

        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${google-gson.version}</version>
            </dependency>

            <dependency>
                <groupId>commons-cli</groupId>
                <artifactId>commons-cli</artifactId>
                <version>${commons-cli.version}</version>
            </dependency>

            <dependency>
                <groupId>de.ipb-halle</groupId>
                <artifactId>crimsy-api</artifactId>
                <version>${crimsy-api.version}</version>
            </dependency>

            <dependency>
                <groupId>de.ipb-halle</groupId>
                <artifactId>crimsy-job-api</artifactId>
                <version>${crimsy-job-api.version}</version>
            </dependency>

            <dependency>
                <groupId>de.ipb-halle</groupId>
                <artifactId>crimsy-test</artifactId>
                <version>${crimsy-test.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Jakarta Platform BOM -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-bom</artifactId>
                <scope>import</scope>
                <type>pom</type>
                <version>${jakarta.platform.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j-api.version}</version>
            </dependency>

            <!-- TomEE BOM -->
            <dependency>
                <groupId>org.apache.tomee.bom</groupId>
                <artifactId>tomee-webprofile-api</artifactId>
                <version>${tomee.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <!-- TestContainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project> 
